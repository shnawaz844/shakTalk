{
  "expo": {
    "name": "ShakTranslate",
    "slug": "shaktalk",
    "owner": "devlopershahs-team",
    "scheme": "shaktranslate",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/96f33856-71d1-4146-9a64-7f00a2625437",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#182527"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cis.shaktranslate",
      "buildNumber": "69",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSMicrophoneUsageDescription": "Allow ShakTranslate to access your microphone for calls and live translation.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "versionCode": 20,
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#182527"
      },
      "adaptiveIcon": {
        "backgroundColor": "#182527",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cis.shaktranslate",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "shaktalk"
            },
            {
              "scheme": "shaktranslate"
            },
            {
              "scheme": "https",
              "host": "www.shaktalk.com",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "shaktalk.com",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@siteed/audio-studio",
        {
          "iosConfig": {
            "microphoneUsageDescription": "Allow ShakTranslate to access your microphone to record speech for translation."
          },
          "enableBackgroundAudio": false,
          "enableNotifications": false,
          "enableDeviceDetection": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow ShakTranslate to access your microphone to record speech for translation."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ShakTranslate to access your camera to scan QR codes for joining sessions."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ShakTranslate to access your photos to update your profile picture."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-asset",
      [
        "expo-updates",
        {
          "handleMissingManagedConfig": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/android-icon-foreground.png",
          "resizeMode": "contain",
          "backgroundColor": "#182527"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      "@config-plugins/react-native-webrtc"
    ],
    "extra": {
      "eas": {
        "projectId": "96f33856-71d1-4146-9a64-7f00a2625437"
      }
    }
  }
}
